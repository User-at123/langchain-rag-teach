# 复制本文件为 .env 并填写你的真实 Key
# ===== DeepSeek 配置（OpenAI 兼容接口）=====
OPENAI_API_KEY=<key>
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 嵌入模型（DeepSeek 无 Embedding API，使用本地开源模型）=====
# 首次运行 rag.py 会自动从 HuggingFace 下载（约 100MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 知识库目录（多格式）=====
# 把 txt/md/pdf/docx/csv 文件放进 ./docs 目录即可被加载（Excel 请另存为 CSV）
# docs/ 为空时回退加载 knowledge_base.txt
DOCS_DIR=./docs

# ===== 向量库存储目录（Chroma 持久化）=====
# 首次运行 rag.py 会创建该目录保存索引，之后运行直接加载，无需重新嵌入
CHROMA_DIR=./chroma_db


HF_ENDPOINT=https://hf-mirror.com


USE_INSECURE_SSL=1
